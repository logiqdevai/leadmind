# ENVIRONMENT
NODE_ENV=
PORT=

# CLIENT_URLS
APP_URL=
API_URL=

# POSTGRES
DATABASE_URL=

# REDIS
REDIS_URL=

# ELASTICSEARCH
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRATION_TIME=

# OAUTH / MCP
# Issuer URL for the OAuth authorization server (defaults to API_URL if unset).
OAUTH_ISSUER=
# Comma-separated secret(s) used to sign oidc-provider's session/interaction cookies.
# Generate from the api/ directory: npx ts-node -r tsconfig-paths/register scripts/generate-oauth-keys.ts
OAUTH_COOKIE_KEYS=
# JSON-stringified private JWKS used to sign access/ID tokens. Must be stable across
# restarts in every environment except local dev (where an ephemeral key is used if unset).
# Generate from the api/ directory: npx ts-node -r tsconfig-paths/register scripts/generate-oauth-keys.ts
OAUTH_JWKS=
# Canonical resource identifier for the MCP server (RFC 8707). Defaults to
# `${API_URL}/mcp` if unset.
MCP_RESOURCE_URL=

# RESEND
RESEND_API_KEY=

# GEMI
GEMI_API_KEY=

# BULLMQ
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
BULLMQ_PREFIX=


