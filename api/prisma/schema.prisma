  PHONE
  IN_PERSON
  CUSTOM
}

enum BookingAssignmentMode {
  /// Rotate between eligible members, least recently assigned first.
  ROUND_ROBIN
  /// The available member with the fewest bookings that day (ties: page priority).
  LEAST_BUSY
}

enum BookingUnavailableSlotsMode {
  /// Booked / blocked times are simply not offered.
  HIDE
  /// Times inside working hours stay visible but disabled when they can't be booked.
  SHOW_DISABLED
