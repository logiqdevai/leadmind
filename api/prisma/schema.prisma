// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  email      String   @unique
  phone      String?  @unique
  full_name  String?
  password   String
  role       AuthRole @default(USER)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  memberships                      OrganisationMember[]
  invitations_sent                 OrganisationInvitation[] @relation("InvitationInvitedBy")
  form_completions                 FormCompletion[]         @relation("CompletedByUser")
  outreach_messages_sent           OutreachMessage[]        @relation("OutreachMessageSentBy")
  activity_logs                    ActivityLog[]            @relation("ActivityLogActor")
  messaging_goals                  MessagingGoal[]
  goal_achievements                GoalAchievement[]
  goal_personal_bests              GoalPersonalBest[]
  bulk_jobs_created                BulkJob[]                @relation("BulkJobCreatedBy")
  openai_batch_jobs_created        OpenAiBatchJob[]         @relation("OpenAiBatchJobCreatedBy")
  sidebar_favorites                SidebarFavorite[]
  api_keys_created                 ApiKey[]                 @relation("ApiKeyCreatedBy")
  oauth_connections_granted        OAuthConnection[]        @relation("OAuthConnectionGrantedBy")
  availability_schedules           AvailabilitySchedule[]
  booking_blocks                   BookingBlock[]           @relation("BookingBlockMember")
  booking_blocks_created           BookingBlock[]           @relation("BookingBlockCreatedBy")
  booking_recurring_blocks         BookingRecurringBlock[]  @relation("BookingRecurringBlockMember")
  booking_recurring_blocks_created BookingRecurringBlock[]  @relation("BookingRecurringBlockCreatedBy")
  booking_pages_created            BookingPage[]            @relation("BookingPageCreatedBy")
  booking_page_memberships         BookingPageMember[]
  booking_links_created            BookingLink[]            @relation("BookingLinkCreatedBy")
  bookings_assigned                Booking[]                @relation("BookingAssignee")
  bookings_created                 Booking[]                @relation("BookingCreatedBy")
  booking_events                   BookingEvent[]           @relation("BookingEventActor")
  calendar_connections             CalendarConnection[]
  reminder_assignments             ReminderAssignee[]       @relation("ReminderAssignee")
  notifications                    Notification[]
  contact_lists_assigned           ContactList[]            @relation("ContactListAssignee")
  sender_profiles                  SenderProfile[]

  @@index([email])
  @@index([phone])
  @@index([uuid])
  @@map("users")
}

model Organisation {
  id                  Int      @id @default(autoincrement())
  uuid                String   @unique @default(uuid())
  name                String
  slug                String   @unique
  timezone            String   @default("UTC")
  reply_to_email      String?  @unique
  reply_forward_email String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  members                   OrganisationMember[]
  invitations               OrganisationInvitation[]
  filters                   Filter[]
  contacts                  Contact[]
  outreach_messages         OutreachMessage[]
  message_threads           MessageThread[]
  outreach_sequences        OutreachSequence[]
  interactions              Interaction[]
  sender_profiles           SenderProfile[]
  marketing_campaigns       MarketingCampaign[]
  scoring_instructions      ScoringInstruction[]
  openai_batch_jobs         OpenAiBatchJob[]
  integrations              Integration[]
  reminders                 Reminder[]
  forms                     Form[]
  contact_lists             ContactList[]
  saved_contact_filters     SavedContactFilter[]
  contact_audience_analyses ContactAudienceAnalysis[]
  ai_usage_logs             AiUsageLog[]
  apify_usage_logs          ApifyUsageLog[]
  message_templates         MessageTemplate[]
  activity_logs             ActivityLog[]
  messaging_goals           MessagingGoal[]
  org_tags                  OrgTag[]
  goal_achievements         GoalAchievement[]
  goal_personal_bests       GoalPersonalBest[]
  bulk_jobs                 BulkJob[]
  website_scrape_requests   WebsiteScrapeRequest[]
  email_send_limits         EmailSendLimit[]
  sending_policies          SendingPolicy[]
  mail_tester_tests         MailTesterTest[]
  mxtoolbox_checks          MxToolboxCheck[]
  api_keys                  ApiKey[]
  oauth_connections         OAuthConnection[]
  mcp_tool_invocation_logs  McpToolInvocationLog[]
  availability_schedules    AvailabilitySchedule[]
  booking_blocks            BookingBlock[]
  booking_recurring_blocks  BookingRecurringBlock[]
  booking_pages             BookingPage[]
  booking_links             BookingLink[]
  bookings                  Booking[]
  booking_invite_settings   BookingInviteSettings?
  booking_invitations       BookingInvitation[]
  booking_events            BookingEvent[]
  calendar_connections      CalendarConnection[]
  notifications             Notification[]

  @@index([uuid])
  @@index([slug])
  @@map("organisations")
}

model OrganisationMember {
  id                Int              @id @default(autoincrement())
  uuid              String           @unique @default(uuid())
  organisation_uuid String
  user_uuid         String
  role              OrganisationRole @default(MEMBER)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  user         User         @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)

  @@unique([organisation_uuid, user_uuid])
  @@index([organisation_uuid])
  @@index([user_uuid])
  @@map("organisation_members")
}

model OrganisationInvitation {
  id                   Int                      @id @default(autoincrement())
  uuid                 String                   @unique @default(uuid())
  organisation_uuid    String
  email                String
  role                 OrganisationInviteRole   @default(MEMBER)
  token                String                   @unique @default(uuid())
  status               OrganisationInviteStatus @default(PENDING)
  invited_by_user_uuid String
  expires_at           DateTime
  accepted_at          DateTime?
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt

  organisation Organisation @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  invited_by   User         @relation("InvitationInvitedBy", fields: [invited_by_user_uuid], references: [uuid], onDelete: Cascade)

  @@index([organisation_uuid])
  @@index([email])
  @@index([token])
  @@index([status])
  @@map("organisation_invitations")
}

model ApiKey {
  id                   Int              @id @default(autoincrement())
  uuid                 String           @unique @default(uuid())
  organisation_uuid    String
  created_by_user_uuid String
  name                 String
  key_prefix           String
  last4                String
  key_hash             String           @unique
  organisation_role    OrganisationRole @default(MEMBER)
  last_used_at         DateTime?
  expires_at           DateTime?
  revoked_at           DateTime?
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  created_by   User         @relation("ApiKeyCreatedBy", fields: [created_by_user_uuid], references: [uuid], onDelete: Cascade)

  @@index([organisation_uuid])
  @@index([key_hash])
  @@map("api_keys")
}

model Filter {
  id                    Int                @id @default(autoincrement())
  uuid                  String             @unique @default(uuid())
  organisation_uuid     String
  name                  String
  source_type           SourceType
  query_config          Json
  enrichment_sources    EnrichmentSource[] @default([])
  enabled               Boolean            @default(true)
  cron_schedule         String?
  channels              Channel[]          @default([EMAIL])
  outreach_instructions String?
  contact_list_uuid     String?
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  organisation                Organisation               @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  contactList                 ContactList?               @relation(fields: [contact_list_uuid], references: [uuid], onDelete: SetNull)
  raw_leads                   RawLead[]
  contacts                    Contact[]
  contact_filters             ContactFilter[]
  jobs                        FilterJob[]
  filter_scoring_instructions FilterScoringInstruction[]
  audience_analyses           ContactAudienceAnalysis[]

  @@index([organisation_uuid])
  @@index([contact_list_uuid])
}

model SavedContactFilter {
  id                Int      @id @default(autoincrement())
  uuid              String   @unique @default(uuid())
  organisation_uuid String
  name              String
  filters           Json
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  organisation Organisation @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)

  @@index([organisation_uuid])
  @@map("saved_contact_filters")
}

model SidebarFavorite {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  user_uuid   String
  nav_key     String
  order_index Int      @default(0)
  created_at  DateTime @default(now())

  user User @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)

  @@unique([user_uuid, nav_key])
  @@index([user_uuid])
  @@map("sidebar_favorites")
}

model ScoringInstruction {
  id                Int      @id @default(autoincrement())
  uuid              String   @unique @default(uuid())
  organisation_uuid String
  name              String
  instructions      String   @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  organisation   Organisation               @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  filter_links   FilterScoringInstruction[]
  contact_scores ContactScore[]

  @@index([organisation_uuid])
  @@map("scoring_instructions")
}

model FilterScoringInstruction {
  filter_uuid              String
  scoring_instruction_uuid String
  created_at               DateTime @default(now())

  filter              Filter             @relation(fields: [filter_uuid], references: [uuid], onDelete: Cascade)
  scoring_instruction ScoringInstruction @relation(fields: [scoring_instruction_uuid], references: [uuid], onDelete: Cascade)

  @@id([filter_uuid, scoring_instruction_uuid])
  @@map("filter_scoring_instructions")
}

model RawLead {
  id           Int        @id @default(autoincrement())
  uuid         String     @unique @default(uuid())
  filter_uuid  String
  source_type  SourceType
  raw_data     Json
  processed_at DateTime?
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  filter Filter @relation(fields: [filter_uuid], references: [uuid], onDelete: Cascade)
  lead   Lead?

  @@index([filter_uuid])
}

// Lead is the generic, public, app-wide record of a person/business.
// It has no owner. Per-user state (status, notes, per-instruction scores) lives on Contact;
// AI-drafted outreach lives on OutreachMessage (one per filter.channel).
// Each Lead is created from a RawLead (`raw_lead_uuid`), which is the audit
// record of what the scraper returned.
model Lead {
  id                        Int                    @id @default(autoincrement())
  uuid                      String                 @unique @default(uuid())
  raw_lead_uuid             String?                @unique
  name                      String?
  email                     String?
  phone                     String?
  company                   String?
  website                   String?
  google_maps_url           String?
  linkedin_url              String?
  title                     String?
  location                  String?
  industry                  String?
  description               String?
  source_type               SourceType
  raw_data                  Json?
  /// Scraped opening hours: { monday: [{ open: "09:00", close: "17:00" }], ... }; copied to a contact's hours when the contact is created.
  opening_hours             Json?
  enrichment_summary        String?                @db.Text
  enrichment_metadata       Json?
  email_validation_status   EmailValidationStatus  @default(UNKNOWN)
  email_validation_reason   String?
  email_validated_at        DateTime?
  website_validation_status DomainValidationStatus @default(UNKNOWN)
  website_validation_reason String?
  website_validated_at      DateTime?
  created_at                DateTime               @default(now())
  updated_at                DateTime               @updatedAt

  raw_lead    RawLead?         @relation(fields: [raw_lead_uuid], references: [uuid], onDelete: SetNull)
  contacts    Contact[]
  enrichments LeadEnrichment[]

  @@index([email])
  @@index([linkedin_url])
}

model LeadEnrichment {
  id            Int              @id @default(autoincrement())
  uuid          String           @unique @default(uuid())
  lead_uuid     String
  source        EnrichmentSource
  source_url    String?
  summary       String?          @db.Text
  payload       Json?
  cost_usd      Decimal?         @db.Decimal(12, 6)
  input_tokens  Int?
  output_tokens Int?
  metadata      Json?
  created_at    DateTime         @default(now())

  lead Lead @relation(fields: [lead_uuid], references: [uuid], onDelete: Cascade)

  @@index([lead_uuid])
  @@index([lead_uuid, source])
  @@map("lead_enrichments")
}

model Contact {
  id                        Int                    @id @default(autoincrement())
  uuid                      String                 @unique @default(uuid())
  organisation_uuid         String
  lead_uuid                 String
  filter_uuid               String?
  status                    LeadStatus             @default(NEW)
  notes                     String?
  name                      String?
  email                     String?
  phone                     String?
  company                   String?
  website                   String?
  google_maps_url           String?
  linkedin_url              String?
  title                     String?
  location                  String?
  industry                  String?
  description               String?
  enrichment_summary        String?                @db.Text
  enrichment_metadata       Json?
  email_validation_status   EmailValidationStatus  @default(UNKNOWN)
  email_validation_reason   String?
  email_validated_at        DateTime?
  website_validation_status DomainValidationStatus @default(UNKNOWN)
  website_validation_reason String?
  website_validated_at      DateTime?
  unsubscribed_at           DateTime?
  unsubscribe_token         String?                @unique
  bounced_at                DateTime?
  bounce_reason             String?
  last_interaction_at       DateTime?
  created_at                DateTime               @default(now())
  updated_at                DateTime               @updatedAt

  organisation         Organisation               @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  lead                 Lead                       @relation(fields: [lead_uuid], references: [uuid], onDelete: Cascade)
  filter               Filter?                    @relation(fields: [filter_uuid], references: [uuid], onDelete: SetNull)
  contact_filters      ContactFilter[]
  tags                 ContactTag[]
  contact_infos        ContactInfo[]
  interactions         Interaction[]
  outreach_messages    OutreachMessage[]
  message_threads      MessageThread[]
  campaign_contacts    MarketingCampaignContact[]
  contact_scores       ContactScore[]
  reminders            Reminder[]
  form_completions     FormCompletion[]
  list_memberships     ContactListMember[]
  enrichments          ContactEnrichment[]
  sequence_enrollments SequenceEnrollment[]
  bookings             Booking[]
  booking_links        BookingLink[]
  booking_invitations  BookingInvitation[]
  opening_hours_rows   ContactOpeningHour[]

  @@unique([organisation_uuid, lead_uuid])
  @@index([organisation_uuid])
  @@index([status])
  @@index([lead_uuid])
  @@index([email])
  @@index([unsubscribed_at])
  @@index([bounced_at])
  @@index([last_interaction_at])
}

/// One opening interval of a contact's business on one weekday; several rows per day = split shifts.
/// Stored as rows (not JSON) so contacts can be filtered by the hours they are open.
model ContactOpeningHour {
  id            Int    @id @default(autoincrement())
  contact_uuid  String
  /// 0 = Monday ... 6 = Sunday
  day_of_week   Int
  /// Minutes after midnight
  opens_minute  Int
  /// Minutes after midnight; above 1440 when the interval runs past midnight into the next day.
  closes_minute Int

  contact Contact @relation(fields: [contact_uuid], references: [uuid], onDelete: Cascade)

  @@index([contact_uuid])
  @@index([day_of_week, opens_minute, closes_minute])
  @@map("contact_opening_hours")
}

model ContactInfo {
  id           Int             @id @default(autoincrement())
  uuid         String          @unique @default(uuid())
  contact_uuid String
  type         ContactInfoType
  value        String
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt

  contact Contact @relation(fields: [contact_uuid], references: [uuid], onDelete: Cascade)

  @@index([contact_uuid])
  @@index([contact_uuid, type])
  @@map("contact_infos")
}

model ContactFilter {
  contact_uuid String
  filter_uuid  String
  created_at   DateTime @default(now())

  contact Contact @relation(fields: [contact_uuid], references: [uuid], onDelete: Cascade)
  filter  Filter  @relation(fields: [filter_uuid], references: [uuid], onDelete: Cascade)

  @@id([contact_uuid, filter_uuid])
  @@index([filter_uuid])
  @@map("contact_filters")
}

model ContactEnrichment {
  id            Int              @id @default(autoincrement())
  uuid          String           @unique @default(uuid())
  contact_uuid  String
  source        EnrichmentSource
  source_url    String?
  summary       String?          @db.Text
  payload       Json?
  cost_usd      Decimal?         @db.Decimal(12, 6)
  input_tokens  Int?
  output_tokens Int?
  metadata      Json?
  created_at    DateTime         @default(now())

  contact Contact @relation(fields: [contact_uuid], references: [uuid], onDelete: Cascade)

  @@index([contact_uuid])
  @@index([contact_uuid, source])
  @@map("contact_enrichments")
}

model ContactScore {
  id                       Int      @id @default(autoincrement())
  contact_uuid             String
  scoring_instruction_uuid String
  score                    Int
  updated_at               DateTime @updatedAt

  contact             Contact            @relation(fields: [contact_uuid], references: [uuid], onDelete: Cascade)
  scoring_instruction ScoringInstruction @relation(fields: [scoring_instruction_uuid], references: [uuid], onDelete: Cascade)

  @@unique([contact_uuid, scoring_instruction_uuid])
  @@index([contact_uuid])
  @@index([scoring_instruction_uuid])
  @@map("contact_scores")
}

model ContactList {
  id                 Int      @id @default(autoincrement())
  uuid               String   @unique @default(uuid())
  organisation_uuid  String
  parent_list_uuid   String?
  /// Team member responsible for this list; cleared if the member is deleted.
  assigned_user_uuid String?
  title              String
  description        String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  organisation         Organisation              @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  assigned_user        User?                     @relation("ContactListAssignee", fields: [assigned_user_uuid], references: [uuid], onDelete: SetNull)
  parent               ContactList?              @relation("ContactListHierarchy", fields: [parent_list_uuid], references: [uuid], onDelete: Cascade)
  children             ContactList[]             @relation("ContactListHierarchy")
  members              ContactListMember[]
  audience_analyses    ContactAudienceAnalysis[]
  filters              Filter[]
  sequence_enrollments SequenceEnrollment[]

  @@index([organisation_uuid])
  @@index([parent_list_uuid])
  @@index([assigned_user_uuid])
  @@map("contact_lists")
}

model ContactListMember {
  id           Int        @id @default(autoincrement())
  uuid         String     @unique @default(uuid())
  list_uuid    String
  contact_uuid String
  status       LeadStatus @default(NEW)
  created_at   DateTime   @default(now())

  list    ContactList @relation(fields: [list_uuid], references: [uuid], onDelete: Cascade)
  contact Contact     @relation(fields: [contact_uuid], references: [uuid], onDelete: Cascade)

  @@unique([list_uuid, contact_uuid])
  @@index([list_uuid])
  @@index([contact_uuid])
  @@map("contact_list_members")
}

model ContactTag {
  id           Int      @id @default(autoincrement())
  contact_uuid String
  tag          String
  created_at   DateTime @default(now())

  contact Contact @relation(fields: [contact_uuid], references: [uuid], onDelete: Cascade)

  @@unique([contact_uuid, tag])
  @@index([contact_uuid])
}

model Interaction {
  id                    Int             @id @default(autoincrement())
  uuid                  String          @unique @default(uuid())
  contact_uuid          String
  organisation_uuid     String
  campaign_uuid         String?
  type                  InteractionType
  content               String?
  metadata              Json?
  status_change         Json?
  outreach_message_uuid String?
  // Who logged it; lets logged calls count toward a user's call goal.
  created_by_user_uuid  String?
  /// Only set on CALL interactions: the status picked from the Quick note list when the call was logged.
  call_note_status      CallNoteStatus?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  contact          Contact            @relation(fields: [contact_uuid], references: [uuid], onDelete: Cascade)
  organisation     Organisation       @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  outreach_message OutreachMessage?   @relation(fields: [outreach_message_uuid], references: [uuid], onDelete: SetNull)
  campaign         MarketingCampaign? @relation(fields: [campaign_uuid], references: [uuid], onDelete: SetNull)

  @@index([contact_uuid])
  @@index([organisation_uuid])
  @@index([campaign_uuid])
  @@index([type])
  @@index([type, call_note_status])
  @@index([created_at])
  @@index([outreach_message_uuid])
  @@index([created_by_user_uuid, type, created_at])
}

model OutreachMessage {
  id                        Int                          @id @default(autoincrement())
  uuid                      String                       @unique @default(uuid())
  organisation_uuid         String
  contact_uuid              String
  campaign_uuid             String?
  sent_by_user_uuid         String?
  channel                   Channel
  direction                 MsgDirection                 @default(OUTBOUND)
  subject                   String?
  content                   String
  status                    MsgStatus                    @default(PENDING)
  provider_message_id       String?
  idempotency_key           String?                      @unique
  scheduled_at              DateTime?
  sent_at                   DateTime?
  delivered_at              DateTime?
  opened_at                 DateTime?
  clicked_at                DateTime?
  replied_at                DateTime?
  bounced_at                DateTime?
  failed_at                 DateTime?
  reply_subject             String?
  reply_text                String?
  reply_html                String?
  inbound_message_id        String?
  in_reply_to_message_id    String?
  message_id                String?
  references                String?
  thread_uuid               String?
  is_manual_reply           Boolean                      @default(false)
  email_provider            ExternalIntegrationProvider?
  email_account             String?
  email_domain_uuid         String?
  from_email                String?
  sms_provider              String?
  metadata                  Json?
  sequence_enrollment_uuid  String?
  sequence_step_uuid        String?
  campaign_integration_uuid String?
  created_at                DateTime                     @default(now())
  updated_at                DateTime                     @updatedAt

  organisation         Organisation          @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  contact              Contact               @relation(fields: [contact_uuid], references: [uuid], onDelete: Cascade)
  campaign             MarketingCampaign?    @relation(fields: [campaign_uuid], references: [uuid], onDelete: SetNull)
  sent_by              User?                 @relation("OutreachMessageSentBy", fields: [sent_by_user_uuid], references: [uuid], onDelete: SetNull)
  interactions         Interaction[]
  sequence_enrollment  SequenceEnrollment?   @relation(fields: [sequence_enrollment_uuid], references: [uuid], onDelete: SetNull)
  sequence_step        OutreachSequenceStep? @relation(fields: [sequence_step_uuid], references: [uuid], onDelete: SetNull)
  campaign_integration CampaignIntegration?  @relation(fields: [campaign_integration_uuid], references: [uuid], onDelete: SetNull)
  reminders            Reminder[]
  thread               MessageThread?        @relation(fields: [thread_uuid], references: [uuid], onDelete: SetNull)

  @@index([organisation_uuid])
  @@index([contact_uuid])
  @@index([status])
  @@index([campaign_uuid])
  @@index([provider_message_id])
  @@index([email_provider])
  @@index([sent_by_user_uuid])
  @@index([campaign_uuid, contact_uuid, channel])
  @@index([organisation_uuid, sent_by_user_uuid, sent_at])
  @@index([sequence_enrollment_uuid])
  @@index([sequence_step_uuid])
  @@index([campaign_integration_uuid])
  @@index([status, scheduled_at])
  @@index([thread_uuid])
  @@index([message_id])
}

enum ThreadOrigin {
  MANUAL
  SEQUENCE
  CAMPAIGN
}

/// Whose turn it is in a conversation, based on the last email that actually went out or came in.
enum ThreadReplyState {
  /// No delivered outbound yet, or the thread is closed (dismissed / bounced / complaint).
  NONE
  /// Their reply is the latest activity - we owe them a response.
  AWAITING_US
  /// Our sent email is the latest activity - we're waiting on them (follow up if this goes stale).
  AWAITING_THEM
}

model MessageThread {
  id                       Int              @id @default(autoincrement())
  uuid                     String           @unique @default(uuid())
  organisation_uuid        String
  contact_uuid             String
  channel                  Channel
  subject                  String?
  origin                   ThreadOrigin
  sequence_enrollment_uuid String?
  campaign_uuid            String?
  dedupe_key               String?          @unique
  last_message_at          DateTime?
  message_count            Int              @default(0)
  last_inbound_at          DateTime?
  last_outbound_at         DateTime?
  reply_state              ThreadReplyState @default(NONE)
  has_unread_reply         Boolean          @default(false)
  manual_follow_up_at      DateTime?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt

  organisation Organisation      @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  contact      Contact           @relation(fields: [contact_uuid], references: [uuid], onDelete: Cascade)
  messages     OutreachMessage[]

  @@index([organisation_uuid, contact_uuid])
  @@index([contact_uuid, channel, last_message_at])
  @@index([organisation_uuid, reply_state, last_outbound_at], map: "message_threads_org_reply_state_last_outbound_idx")
  @@map("message_threads")
}

model OutreachSequence {
  id                  Int            @id @default(autoincrement())
  uuid                String         @unique @default(uuid())
  organisation_uuid   String
  name                String
  description         String?
  status              SequenceStatus @default(DRAFT)
  stop_on_reply       Boolean        @default(true)
  // Sender profile used for messages of standalone (non-campaign) enrollments.
  sender_profile_uuid String?
  /// ISO weekdays (1=Mon..7=Sun) steps may be scheduled on, evaluated in the organisation timezone.
  /// A step landing on a disallowed day is shifted to the next allowed day (same time of day).
  allowed_weekdays    Int[]          @default([1, 2, 3, 4, 5, 6, 7])
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  organisation   Organisation           @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  sender_profile SenderProfile?         @relation(fields: [sender_profile_uuid], references: [uuid], onDelete: SetNull)
  steps          OutreachSequenceStep[]
  enrollments    SequenceEnrollment[]
  campaigns      MarketingCampaign[]

  @@index([organisation_uuid])
  @@index([organisation_uuid, status])
  @@index([sender_profile_uuid])
}

model OutreachSequenceStep {
  id                    Int                    @id @default(autoincrement())
  uuid                  String                 @unique @default(uuid())
  sequence_uuid         String
  order_index           Int
  enabled               Boolean                @default(true)
  channel               Channel
  email_subject         String?
  email_content         String?                @db.Text
  sms_content           String?                @db.Text
  message_template_uuid String?
  delay_value           Int
  delay_unit            SequenceDelayUnit      @default(HOURS)
  delay_reference       SequenceDelayReference @default(PREVIOUS_STEP)
  send_time             String?                @db.VarChar(5)
  // Booking page whose contact-specific link `{{booking_link}}` resolves to for this step's recipients.
  booking_page_uuid     String?
  // Append a booking call-to-action block when the content has no `{{booking_link}}` of its own.
  append_booking_cta    Boolean                @default(false)
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt

  sequence          OutreachSequence  @relation(fields: [sequence_uuid], references: [uuid], onDelete: Cascade)
  message_template  MessageTemplate?  @relation(fields: [message_template_uuid], references: [uuid], onDelete: SetNull)
  booking_page      BookingPage?      @relation(fields: [booking_page_uuid], references: [uuid], onDelete: SetNull)
  outreach_messages OutreachMessage[]

  @@index([sequence_uuid])
  @@index([sequence_uuid, order_index])
  @@index([message_template_uuid])
  @@index([booking_page_uuid])
  @@map("outreach_sequence_steps")
}

