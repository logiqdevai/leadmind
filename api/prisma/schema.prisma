/// A reusable ramp-up / pacing configuration: an ordered list of SendingPolicyStages
/// (e.g. 30/day x 3 days -> 40/day x 5 days -> 50/day until complete).
/// `is_template` rows are the org's reusable library; assigning one to a
/// CampaignIntegration clones it (is_template=false, source_policy_uuid set)
/// into an immutable snapshot so editing the template never changes a running campaign.
model SendingPolicy {
  id                          Int      @id @default(autoincrement())
  uuid                        String   @unique @default(uuid())
  organisation_uuid           String
  name                        String
  description                 String?
  is_template                 Boolean  @default(true)
  source_policy_uuid          String?
  timezone                    String   @default("UTC")
  window_start_minute         Int?
  window_end_minute           Int?
  /// ISO weekdays (1=Mon..7=Sun) sending is allowed on, evaluated in `timezone`.
  allowed_weekdays            Int[]    @default([1, 2, 3, 4, 5, 6, 7])
  min_interval_seconds        Int      @default(0)
  min_interval_jitter_seconds Int      @default(0)
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  organisation          Organisation          @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  source_policy         SendingPolicy?        @relation("PolicyClone", fields: [source_policy_uuid], references: [uuid], onDelete: SetNull)
  cloned_instances      SendingPolicy[]       @relation("PolicyClone")
  stages                SendingPolicyStage[]
  campaign_integrations CampaignIntegration[]

  @@index([organisation_uuid, is_template])
  @@index([source_policy_uuid])
  @@map("sending_policies")
}

/// One ramp-up stage of a SendingPolicy. duration_value=null marks the final,
/// indefinite stage (lasts until campaign completion).
model SendingPolicyStage {
  id                  Int                @id @default(autoincrement())
  uuid                String             @unique @default(uuid())
  sending_policy_uuid String
  order_index         Int
  limit               Int
  period_unit         SendingPeriodUnit
  duration_value      Int?
  duration_unit       SendingPeriodUnit?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  sending_policy SendingPolicy @relation(fields: [sending_policy_uuid], references: [uuid], onDelete: Cascade)

  @@unique([sending_policy_uuid, order_index])
  @@map("sending_policy_stages")
}

/// Assigns one email IntegrationAccount to a campaign with a cloned SendingPolicy.
/// This is the config layer; CampaignIntegrationState below is the runtime layer.
model CampaignIntegration {
  id                              Int                       @id @default(autoincrement())
  uuid                            String                    @unique @default(uuid())
  campaign_uuid                   String
  integration_account_uuid        String
  integration_account_domain_uuid String?
  sending_policy_uuid             String
  status                          CampaignIntegrationStatus @default(ACTIVE)
  created_at                      DateTime                  @default(now())
  updated_at                      DateTime                  @updatedAt

  campaign                   MarketingCampaign         @relation(fields: [campaign_uuid], references: [uuid], onDelete: Cascade)
  integration_account        IntegrationAccount        @relation(fields: [integration_account_uuid], references: [uuid], onDelete: Cascade)
  integration_account_domain IntegrationAccountDomain? @relation(fields: [integration_account_domain_uuid], references: [uuid], onDelete: SetNull)
  sending_policy             SendingPolicy             @relation(fields: [sending_policy_uuid], references: [uuid], onDelete: Restrict)
  state                      CampaignIntegrationState?
  outreach_messages          OutreachMessage[]

  @@unique([campaign_uuid, integration_account_uuid])
  @@index([campaign_uuid, status])
  @@index([integration_account_uuid])
  @@index([integration_account_domain_uuid])
  @@map("campaign_integrations")
}

/// Runtime state for a CampaignIntegration. Deliberately holds no "current stage" -
/// the current stage is always derived from policy_started_at + the policy's stages.
model CampaignIntegrationState {
  id                        Int       @id @default(autoincrement())
  uuid                      String    @unique @default(uuid())
  campaign_integration_uuid String    @unique
  policy_started_at         DateTime?
  last_sent_at              DateTime?
  lifetime_sent_count       Int       @default(0)
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  campaign_integration CampaignIntegration @relation(fields: [campaign_integration_uuid], references: [uuid], onDelete: Cascade)

  @@map("campaign_integration_states")
}

