/// Weekly working hours of one team member within an organisation.
model AvailabilitySchedule {
  id                Int      @id @default(autoincrement())
  uuid              String   @unique @default(uuid())
  organisation_uuid String
  user_uuid         String
  timezone          String   @default("UTC")
  /// ISO weekday ("1"=Mon .. "7"=Sun) -> [{ start: "HH:MM", end: "HH:MM" }]. Gaps between periods are breaks.
  weekly_hours      Json
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  organisation Organisation           @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  user         User                   @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  overrides    AvailabilityOverride[]

  @@unique([organisation_uuid, user_uuid])
  @@index([user_uuid])
  @@map("availability_schedules")
}

/// Replaces the weekly hours for one calendar date (in the schedule timezone). Empty intervals = unavailable all day.
model AvailabilityOverride {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  schedule_uuid String
  date          String   @db.VarChar(10)
  intervals     Json
  reason        String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  schedule AvailabilitySchedule @relation(fields: [schedule_uuid], references: [uuid], onDelete: Cascade)

  @@unique([schedule_uuid, date])
  @@map("availability_overrides")
}

/// Unavailable period (holiday, vacation, blocked slot). user_uuid null = blocks every member of the organisation.
model BookingBlock {
  id                   Int      @id @default(autoincrement())
  uuid                 String   @unique @default(uuid())
  organisation_uuid    String
  user_uuid            String?
  start_at             DateTime
  end_at               DateTime
  reason               String?
  created_by_user_uuid String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  organisation Organisation @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  user         User?        @relation("BookingBlockMember", fields: [user_uuid], references: [uuid], onDelete: Cascade)
  created_by   User?        @relation("BookingBlockCreatedBy", fields: [created_by_user_uuid], references: [uuid], onDelete: SetNull)

  @@index([organisation_uuid, start_at])
  @@index([user_uuid, start_at])
  @@map("booking_blocks")
}

/// A weekly-repeating blocked time window (e.g. every weekday 12:00-13:00). Expanded into busy time when slots are computed.
model BookingRecurringBlock {
  id                   Int      @id @default(autoincrement())
  uuid                 String   @unique @default(uuid())
  organisation_uuid    String
  /// Null = every member of the organisation.
  user_uuid            String?
  /// ISO weekdays: 1 = Monday .. 7 = Sunday.
  weekdays             Int[]
  /// "HH:MM" wall-clock times in `timezone` ("24:00" allowed for end).
  start_time           String
  end_time             String
  timezone             String
  reason               String?
  created_by_user_uuid String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  organisation Organisation @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  user         User?        @relation("BookingRecurringBlockMember", fields: [user_uuid], references: [uuid], onDelete: Cascade)
  created_by   User?        @relation("BookingRecurringBlockCreatedBy", fields: [created_by_user_uuid], references: [uuid], onDelete: SetNull)

  @@index([organisation_uuid])
  @@index([user_uuid])
  @@map("booking_recurring_blocks")
}

/// A bookable appointment type (sales call, demo, onboarding...) with its own scheduling, team and notification rules.
model BookingPage {
  id                   Int     @id @default(autoincrement())
  uuid                 String  @unique @default(uuid())
  organisation_uuid    String
  created_by_user_uuid String?
  name                 String
  slug                 String
  is_active            Boolean @default(true)
  /// Used for `{{booking_link}}` when a template/step does not pick a page.
  is_default           Boolean @default(false)

  // Public page content & branding
  title                String?
  description          String?  @db.Text
  intro_text           String?  @db.Text
  /// "What to expect" bullet points shown on the public page (shared by every link of the page).
  expectations         String[] @default([])
  brand_name           String?
  logo_url             String?
  primary_color        String?  @db.VarChar(9)
  confirmation_message String?  @db.Text
  redirect_url         String?
  cta_label            String?
  show_team_member     Boolean  @default(true)
  show_timezone        Boolean  @default(true)
  /// [{ id, label, type: TEXT|TEXTAREA|SELECT|CHECKBOX, required, options? }]
  questions            Json?
  require_phone        Boolean  @default(false)

  // Scheduling rules
  duration_minutes            Int                         @default(30)
  /// Extra durations the invitee may choose from (duration_minutes is always offered).
  duration_options            Int[]                       @default([])
  /// Step between offered start times; null = duration_minutes.
  slot_interval_minutes       Int?
  min_notice_minutes          Int                         @default(240)
  max_advance_days            Int                         @default(60)
  buffer_before_minutes       Int                         @default(0)
  buffer_after_minutes        Int                         @default(0)
  /// Minimum free time between this booking and any other booking of the member.
  min_gap_minutes             Int                         @default(0)
  /// When set and the member already has bookings that day, new slots must start/end within this many minutes of one.
  max_gap_minutes             Int?
  max_bookings_per_day        Int?
  /// Invitees that can share the same slot with the same member (group sessions).
  seats_per_slot              Int                         @default(1)
  assignment_mode             BookingAssignmentMode       @default(ROUND_ROBIN)
  /// Off by default: assignment is internal. Only when enabled may invitees pick a member.
  allow_invitee_member_choice Boolean                     @default(false)
  requires_confirmation       Boolean                     @default(false)
  /// Marking a booking completed logs a MEETING (outcome COMPLETED) on its contact.
  auto_log_meeting            Boolean                     @default(true)
  /// How public pages show start times that are inside working hours but not bookable.
  unavailable_slots_mode      BookingUnavailableSlotsMode @default(HIDE)

  // Location
  location_type  BookingLocationType @default(GOOGLE_MEET)
  location_value String?

  // Cancellation & rescheduling policy
  allow_cancellation            Boolean @default(true)
  allow_reschedule              Boolean @default(true)
  cancellation_deadline_minutes Int     @default(0)
  reschedule_deadline_minutes   Int     @default(0)
  require_cancellation_reason   Boolean @default(false)

  // Notifications
  send_confirmation_email      Boolean  @default(true)
  send_reminder_emails         Boolean  @default(true)
  reminder_offsets_minutes     Int[]    @default([1440, 60])
  send_cancellation_email      Boolean  @default(true)
  send_reschedule_email        Boolean  @default(true)
  /// Off by default: the assignee is only emailed when the page opts in.
  notify_assignee              Boolean  @default(false)
  additional_recipients        String[] @default([])
  include_meeting_link         Boolean  @default(true)
  include_calendar_details     Boolean  @default(true)
  /// Create a Meeting reminder on the contact's Reminders for confirmed bookings (kept in sync on changes).
  create_team_reminder         Boolean  @default(false)
  /// How long before the start the team reminder is due.
  team_reminder_offset_minutes Int      @default(60)
  confirmation_template_uuid   String?
  reminder_template_uuid       String?
  cancellation_template_uuid   String?
  reschedule_template_uuid     String?

  // Google Calendar event content (supports booking variables)
  calendar_event_title       String?
  calendar_event_description String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organisation          Organisation           @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  created_by            User?                  @relation("BookingPageCreatedBy", fields: [created_by_user_uuid], references: [uuid], onDelete: SetNull)
  confirmation_template MessageTemplate?       @relation("BookingPageConfirmationTemplate", fields: [confirmation_template_uuid], references: [uuid], onDelete: SetNull)
  reminder_template     MessageTemplate?       @relation("BookingPageReminderTemplate", fields: [reminder_template_uuid], references: [uuid], onDelete: SetNull)
  cancellation_template MessageTemplate?       @relation("BookingPageCancellationTemplate", fields: [cancellation_template_uuid], references: [uuid], onDelete: SetNull)
  reschedule_template   MessageTemplate?       @relation("BookingPageRescheduleTemplate", fields: [reschedule_template_uuid], references: [uuid], onDelete: SetNull)
  members               BookingPageMember[]
  links                 BookingLink[]
  bookings              Booking[]
  invitations           BookingInvitation[]
  message_templates     MessageTemplate[]      @relation("MessageTemplateBookingPage")
  sequence_steps        OutreachSequenceStep[]

  @@unique([organisation_uuid, slug])
  @@index([organisation_uuid])
  @@map("booking_pages")
}

/// Team member eligible to be assigned bookings of a page.
model BookingPageMember {
  id                Int       @id @default(autoincrement())
  booking_page_uuid String
  user_uuid         String
  priority          Int       @default(0)
  last_assigned_at  DateTime?
  created_at        DateTime  @default(now())

  booking_page BookingPage @relation(fields: [booking_page_uuid], references: [uuid], onDelete: Cascade)
  user         User        @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)

  @@unique([booking_page_uuid, user_uuid])
  @@index([user_uuid])
  @@map("booking_page_members")
}

/// Public entry point to a booking page, addressed by a short random code. contact_uuid set = contact-specific link.
model BookingLink {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(uuid())
  code                 String    @unique @db.VarChar(16)
  organisation_uuid    String
  booking_page_uuid    String
  contact_uuid         String?
  label                String?
  /// Generic links only: create (or match) a Contact from the invitee's details.
  auto_create_contact  Boolean   @default(false)
  is_active            Boolean   @default(true)
  created_by_user_uuid String?
  deactivated_at       DateTime?
  last_used_at         DateTime?
  last_visited_at      DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  organisation Organisation        @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  booking_page BookingPage         @relation(fields: [booking_page_uuid], references: [uuid], onDelete: Cascade)
  contact      Contact?            @relation(fields: [contact_uuid], references: [uuid], onDelete: Cascade)
  created_by   User?               @relation("BookingLinkCreatedBy", fields: [created_by_user_uuid], references: [uuid], onDelete: SetNull)
  bookings     Booking[]
  invitations  BookingInvitation[]
  visits       BookingLinkVisit[]

  @@index([organisation_uuid])
  @@index([booking_page_uuid, contact_uuid, is_active])
  @@index([contact_uuid])
  @@map("booking_links")
}

/// One row per load of a booking link's public page.
model BookingLinkVisit {
  id                Int      @id @default(autoincrement())
  uuid              String   @unique @default(uuid())
  booking_link_uuid String
  user_agent        String?  @db.VarChar(512)
  referrer          String?  @db.VarChar(512)
  created_at        DateTime @default(now())

  booking_link BookingLink @relation(fields: [booking_link_uuid], references: [uuid], onDelete: Cascade)

  @@index([booking_link_uuid, created_at])
  @@map("booking_link_visits")
}

model Booking {
  id                   Int           @id @default(autoincrement())
  uuid                 String        @unique @default(uuid())
  organisation_uuid    String
  booking_page_uuid    String?
  booking_link_uuid    String?
  contact_uuid         String?
  assigned_user_uuid   String?
  created_by_user_uuid String?
  source               BookingSource
  status               BookingStatus @default(CONFIRMED)

  start_at         DateTime
  end_at           DateTime
  duration_minutes Int
  invitee_timezone String?

  // Invitee details as submitted (kept even when a Contact is linked, so history survives contact edits).
  invitee_name    String
  invitee_email   String
  invitee_phone   String?
  invitee_company String?
  invitee_notes   String? @db.Text
  /// { [question_id]: answer }
  answers         Json?
  internal_notes  String? @db.Text

  location_type  BookingLocationType @default(NONE)
  location_value String?
  meeting_url    String?

  /// Team reminder created for this booking (see BookingPage.create_team_reminder); cleared if the reminder is deleted.
  reminder_uuid            String?            @unique
  /// Set on source REMINDER bookings: the reminder this placeholder was made for. Deleted with it.
  source_reminder_uuid     String?            @unique
  calendar_connection_uuid String?
  calendar_event_id        String?
  calendar_html_link       String?
  calendar_sync_status     CalendarSyncStatus @default(NOT_SYNCED)
  calendar_sync_error      String?
  calendar_synced_at       DateTime?

  /// Secret for the invitee's cancel/reschedule links.
  manage_token        String            @unique
  confirmed_at        DateTime?
  cancelled_at        DateTime?
  cancellation_reason String?           @db.Text
  cancelled_by        BookingActorType?
  reschedule_count    Int               @default(0)
  completed_at        DateTime?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  organisation        Organisation          @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  booking_page        BookingPage?          @relation(fields: [booking_page_uuid], references: [uuid], onDelete: SetNull)
  booking_link        BookingLink?          @relation(fields: [booking_link_uuid], references: [uuid], onDelete: SetNull)
  contact             Contact?              @relation(fields: [contact_uuid], references: [uuid], onDelete: SetNull)
  assigned_user       User?                 @relation("BookingAssignee", fields: [assigned_user_uuid], references: [uuid], onDelete: SetNull)
  created_by          User?                 @relation("BookingCreatedBy", fields: [created_by_user_uuid], references: [uuid], onDelete: SetNull)
  calendar_connection CalendarConnection?   @relation(fields: [calendar_connection_uuid], references: [uuid], onDelete: SetNull)
  reminder            Reminder?             @relation("BookingTeamReminder", fields: [reminder_uuid], references: [uuid], onDelete: SetNull)
  source_reminder     Reminder?             @relation("BookingSourceReminder", fields: [source_reminder_uuid], references: [uuid], onDelete: Cascade)
  events              BookingEvent[]
  notifications       BookingNotification[]

  @@index([organisation_uuid, start_at])
  @@index([organisation_uuid, status])
  @@index([assigned_user_uuid, start_at])
  @@index([booking_page_uuid, start_at])
  @@index([contact_uuid])
  @@map("bookings")
}

/// Audit trail of a booking: lifecycle changes, notifications and calendar sync results.
model BookingEvent {
  id                Int              @id @default(autoincrement())
  uuid              String           @unique @default(uuid())
  organisation_uuid String
  booking_uuid      String
  type              BookingEventType
  actor_type        BookingActorType
  actor_user_uuid   String?
  summary           String?
  metadata          Json?
  created_at        DateTime         @default(now())

  organisation Organisation @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  booking      Booking      @relation(fields: [booking_uuid], references: [uuid], onDelete: Cascade)
  actor        User?        @relation("BookingEventActor", fields: [actor_user_uuid], references: [uuid], onDelete: SetNull)

  @@index([booking_uuid, created_at])
  @@index([organisation_uuid, created_at])
  @@map("booking_events")
}

/// Organisation-wide defaults for booking links emailed to contacts (one row per organisation, created on first save).
model BookingInviteSettings {
  id                   Int               @id @default(autoincrement())
  organisation_uuid    String            @unique
  /// Remind contacts who have not booked yet.
  reminder_enabled     Boolean           @default(true)
  reminder_delay_value Int               @default(3)
  reminder_delay_unit  BookingInviteUnit @default(DAYS)
  /// Total reminders per invitation, each one `reminder delay` after the previous email.
  max_reminders        Int               @default(1)
  invite_subject       String?
  invite_message       String?           @db.Text
  reminder_subject     String?
  reminder_message     String?           @db.Text
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt

  organisation Organisation @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)

  @@map("booking_invite_settings")
}

/// A booking link emailed to a contact, and the state of its follow-up reminders.
model BookingInvitation {
  id                     Int                     @id @default(autoincrement())
  uuid                   String                  @unique @default(uuid())
  organisation_uuid      String
  booking_page_uuid      String
  booking_link_uuid      String
  contact_uuid           String
  sent_by_user_uuid      String?
  recipient_email        String
  status                 BookingInvitationStatus @default(ACTIVE)
  /// Settings captured when the invitation was sent, so later settings changes never rewrite a running sequence.
  reminder_enabled       Boolean                 @default(false)
  reminder_delay_minutes Int                     @default(0)
  max_reminders          Int                     @default(0)
  reminders_sent         Int                     @default(0)
  next_reminder_at       DateTime?
  last_error             String?                 @db.Text
  sent_at                DateTime                @default(now())
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt

  organisation Organisation @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  booking_page BookingPage  @relation(fields: [booking_page_uuid], references: [uuid], onDelete: Cascade)
  booking_link BookingLink  @relation(fields: [booking_link_uuid], references: [uuid], onDelete: Cascade)
  contact      Contact      @relation(fields: [contact_uuid], references: [uuid], onDelete: Cascade)

  @@index([organisation_uuid])
  @@index([contact_uuid, sent_at])
  @@index([booking_link_uuid])
  @@map("booking_invitations")
}

/// One row per email attempt; dedupe_key makes retries and duplicate jobs idempotent.
model BookingNotification {
  id              Int                       @id @default(autoincrement())
  uuid            String                    @unique @default(uuid())
  booking_uuid    String
  kind            BookingNotificationKind
  recipient_email String
  dedupe_key      String                    @unique
  status          BookingNotificationStatus
  error           String?                   @db.Text
  sent_at         DateTime?
  created_at      DateTime                  @default(now())

  booking Booking @relation(fields: [booking_uuid], references: [uuid], onDelete: Cascade)

  @@index([booking_uuid])
  @@map("booking_notifications")
}

/// A team member's Google Calendar, connected through Composio (one connected account per member per organisation).
model CalendarConnection {
  id                            Int                      @id @default(autoincrement())
  uuid                          String                   @unique @default(uuid())
  organisation_uuid             String
  user_uuid                     String
  provider                      CalendarProvider         @default(GOOGLE)
  composio_connected_account_id String?                  @unique
  /// Account created by the last connect attempt; the OAuth callback must present this id to activate it.
  pending_connected_account_id  String?
  status                        CalendarConnectionStatus @default(INITIATED)
  account_email                 String?
  calendar_id                   String                   @default("primary")
  calendar_name                 String?
  /// Treat busy times in the connected calendar as unavailable.
  check_conflicts               Boolean                  @default(true)
  last_error                    String?                  @db.Text
  connected_at                  DateTime?
  /// Google incremental-sync cursor: everything changed since it is returned, however long we were offline.
  sync_token                    String?                  @db.Text
  /// Google push-notification channel (events.watch). Google calls our webhook when the calendar changes.
  watch_channel_id              String?                  @unique
  watch_resource_id             String?
  watch_token                   String?
  watch_expires_at              DateTime?
  created_at                    DateTime                 @default(now())
  updated_at                    DateTime                 @updatedAt

  organisation Organisation @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  user         User         @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  bookings     Booking[]

  @@unique([organisation_uuid, user_uuid, provider])
  @@index([user_uuid])
  @@map("calendar_connections")
}

enum NotificationType {
  REMINDER_DUE
  BOOKING_CREATED
  BOOKING_REQUESTED
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED
  BOOKING_ASSIGNED
}

/// In-app notification for one member (a reminder coming due, a booking changing). Pushed live over the websocket.
model Notification {
  id                Int              @id @default(autoincrement())
  uuid              String           @unique @default(uuid())
  organisation_uuid String
  user_uuid         String
  type              NotificationType
  title             String
  body              String?          @db.Text
  entity_type       String?
  entity_uuid       String?
  /// Type-specific details shown in the notification modal.
  data              Json?
  read_at           DateTime?
  created_at        DateTime         @default(now())

  organisation Organisation @relation(fields: [organisation_uuid], references: [uuid], onDelete: Cascade)
  user         User         @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)

  @@index([user_uuid, organisation_uuid, created_at])
  @@index([user_uuid, organisation_uuid, read_at])
  @@map("notifications")
}
