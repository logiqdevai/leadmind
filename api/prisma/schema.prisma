  RESCHEDULED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  PUBLIC
  MANUAL
  /// Placeholder holding the time of a reminder that was added to Google Calendar (no invitee).
  REMINDER
}

enum BookingLocationType {
  NONE
